\name{carswitching}
\alias{carswitching}
\docType{data}
\title{
Brand switching between different of car segments
}
\description{A data matrix with carswitching among 16 types of car segments. The data are frequencies of cars bought and traded in for a new car.
Row (or Column) names of this matrix give labels for the types of cars.
}
\usage{data("carswitching")}
\references{
Harshman R. A., Green P. E., Wind Y., and Lundy M. E. (1982). A Model for the Analysis of Asymmetric Data in Marketing Research. Marketing Science, 1, 205-212.
}
\examples{
data(carswitching)
}
\details{The rows and columns represent one of 16 market categories. The levels and their abbreviations are as follows:\itemize{\item \strong{SUBD} (Subcompact domestic)\item \strong{SUBC} (Subcompact captive imports)\item \strong{SUBI} (Subcompact imports)\item \strong{SMAD} (Small specialty domestic)\item \strong{SMAC} (Small specialty captive imports)\item \strong{SMAI} (Small specialty imports)\item \strong{COML} (Low price compact)\item \strong{COMM} (Medium price compact)\item \strong{COMI} (Import compact)\item \strong{MIDD} (Midsize domestic)\item \strong{MIDI} (Midsize imports)\item \strong{MIDS} (Midsize specialty)\item \strong{STDL} (Low price standard)\item \strong{STDM} (Medium price standard)\item \strong{LUXD} (Luxury domestic)\item \strong{LUXI} (Luxury import)}}
\keyword{Datasets}
